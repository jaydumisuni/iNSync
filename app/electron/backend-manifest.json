{
  "schema": "ttg.ui-backend-sidecar.v2",
  "protocol": "jsonl-rpc-stdio-events",
  "development": {
    "executable": "python",
    "args": [
      "backend/insync_backend.py"
    ],
    "cwd": "../.."
  },
  "packaged": {
    "executable": "sidecars/iNSync-backend",
    "args": []
  },
  "allowedMethods": [
    "app.snapshot",
    "sharing.status",
    "adb.devices",
    "job.submit",
    "job.cancel",
    "job.status",
    "job.list"
  ],
  "note": "Renderer submits long operations as jobs. Product-owned sidecar performs transport/device work and streams progress events; Electron renderer never runs blocking transport commands."
}
